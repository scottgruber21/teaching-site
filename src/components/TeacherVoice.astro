<script>
  const bubble = document.getElementById('teacher-bubble');
  const textContainer = document.getElementById('teacher-text');
  
  // Guard Clause: Exit if the elements don't exist
  if (!bubble || !textContainer) {
    console.warn("TeacherVoice elements not found in the DOM.");
  } else {
    const observerOptions = { 
      threshold: 0.5,
      rootMargin: "0px 0px -20% 0px" // Trigger slightly before it hits center
    };
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const newText = entry.target.getAttribute('data-insight');
          
          if (newText && bubble && textContainer) {
            // Update classes for the reveal animation
            bubble.classList.remove('opacity-0', 'translate-y-4');
            bubble.classList.add('opacity-100', 'translate-y-0');
            
            // Swap the text
            textContainer.innerText = newText;
          }
        }
      });
    }, observerOptions);

    // Watch all elements with the 'data-insight' attribute
    document.querySelectorAll('[data-insight]').forEach(section => observer.observe(section));
  }
</script>